# ============================================================
# Project Genesis - Backend Environment Variables
# Copy this file to .env and fill in your actual values.
# ============================================================

# Application Security
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY

# Database (PostgreSQL for production, SQLite default for local dev)
# PostgreSQL: postgresql+psycopg://user:password@host:5432/genesis_db
DATABASE_URL=sqlite:///./genesis.db

# OpenAI API Key (leave empty to use AI simulation fallback)
OPENAI_API_KEY=

# File Upload Directory
UPLOAD_DIR=uploads

# ChromaDB Vector Store Directory
CHROMA_DB_DIR=chroma_db
